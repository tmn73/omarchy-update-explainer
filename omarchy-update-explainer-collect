#!/usr/bin/env bash
# Print what `omarchy update` would change right now, as one JSON document.
# Read only: it never changes the system and makes no call to GitHub.
# Contract: one JSON document on stdout, exit 0 for every failure the user can meet.
set -uo pipefail

mode=${1:-}
report_file=${2:-}
if [[ $mode == --report && -n $report_file && $# -eq 2 ]]; then
  :
elif [[ $mode == --summary && $# -eq 1 ]]; then
  :
else
  echo "usage: omarchy-update-explainer-collect --summary | --report <file>" >&2
  exit 2
fi

work=$(mktemp -d) || exit 1
tmp_report=""
trap 'rm -rf "$work"; [[ -n $tmp_report ]] && rm -f "$tmp_report"' EXIT

notes=()
note() { notes+=("$1"); }

emit() {
  local state=$1 message=$2
  jq -n \
    --arg state "$state" --arg message "$message" \
    --arg generatedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson pending "${omarchy_pending:-false}" \
    --arg package "${omarchy_pkg:-}" --arg from "${old_ver:-}" --arg to "${new_ver:-}" \
    --argjson pacman "${n_pacman:-0}" --argjson aur "${n_aur:-0}" --argjson mise "${n_mise:-0}" \
    --argjson download "${download_mib:-null}" \
    --argjson partial "${download_partial:-false}" \
    --argjson reboot "${reboot:-false}" \
    --args '{
      state: $state, message: $message, generatedAt: $generatedAt,
      omarchy: {pending: $pending, package: $package, from: $from, to: $to},
      sources: {pacman: $pacman, aur: $aur, mise: $mise},
      total: ($pacman + $aur + $mise),
      downloadMiB: $download, downloadPartial: $partial,
      reboot: $reboot, notes: $ARGS.positional
    }' "${notes[@]}"
}

emit_report() {
  jq -n --arg path "$1" '{state: "ok", path: $path}'
}

# Report an error in the format of the current mode.
fail_out() {
  if [[ $mode == --report ]]; then
    jq -n --arg message "$1" '{state: "error", message: $message}'
  else
    emit error "$1"
  fi
}

if [[ $mode == --report ]]; then
  # Fail early, before the slow collection, when the file cannot be written.
  tmp_report=$(mktemp --suffix=.tmp "$report_file.XXXXXX" 2>&1) || {
    msg=$tmp_report
    tmp_report=""
    jq -n --arg message "cannot write the report: $msg" '{state: "error", message: $message}'
    exit 0
  }
  chmod 600 "$tmp_report"
fi

# Slow network calls run in the background while pacman syncs.
aur_pid=""
mise_pid=""
: >"$work/aur"
: >"$work/mise"
if command -v yay >/dev/null 2>&1; then
  { yay -Qua 2>/dev/null | grep -vE '^(gcc14|gcc14-libs) ' >"$work/aur"; } &
  aur_pid=$!
else
  note "yay is not installed, AUR updates were not checked"
fi
if command -v mise >/dev/null 2>&1; then
  MISE_MINIMUM_RELEASE_AGE=0 mise outdated --no-header 2>/dev/null >"$work/mise" &
  mise_pid=$!
else
  note "mise is not installed, tool updates were not checked"
fi
wait_background() {
  [[ -n $aur_pid ]] && wait "$aur_pid"
  [[ -n $mise_pid ]] && wait "$mise_pid"
  return 0
}

if ! command -v checkupdates >/dev/null 2>&1; then
  wait_background
  fail_out "checkupdates is not installed (package pacman-contrib)"
  exit 0
fi

# checkupdates and `pacman -Sup` share one sync database and one lock file.
# Two overlapping runs (ours, or the stock update widget) make the second one
# fail. So this helper syncs a private database, and a lock under the runtime
# directory serializes our own runs. Without a runtime directory nothing is
# created and the tools keep their defaults. The lock descriptor is opened
# after the background jobs start, so they do not inherit it.
lock_fd=""
runtime_dir=${XDG_RUNTIME_DIR:-}
if [[ -n $runtime_dir ]] && command -v flock >/dev/null 2>&1; then
  state_dir="$runtime_dir/update-explainer"
  if mkdir -p -m 700 "$state_dir" 2>/dev/null && exec {lock_fd}>"$state_dir/collect.lock" 2>/dev/null; then
    export CHECKUPDATES_DB="$state_dir/checkup-db/"
    flock "$lock_fd"
  else
    lock_fd=""
  fi
fi
release_lock() {
  [[ -n $lock_fd ]] && exec {lock_fd}>&-
  lock_fd=""
}

checkupdates --nocolor >"$work/check-out" 2>"$work/check-err"
check_status=$?
if (( check_status == 1 )); then
  release_lock
  wait_background
  err=$(head -c 2000 "$work/check-err")
  fail_out "checkupdates failed: ${err:-no error text}"
  exit 0
fi

# Read the pacman transaction into $work/transaction ("name version repo size").
# Sets transaction_ok. Used by both modes. Falls back to the checkupdates lines.
read_transaction() {
  : >"$work/transaction"
  transaction_ok=true
  if (( check_status == 0 )); then
    transaction_ok=false
    if command -v fakeroot >/dev/null 2>&1; then
      db="${CHECKUPDATES_DB:-${TMPDIR:-/tmp}/checkup-db-${UID}/}"
      if fakeroot -- pacman -Sup --disable-sandbox-filesystem --dbpath "$db" --logfile /dev/null \
        --print-format '%n %v %r %s' 2>/dev/null >"$work/transaction"; then
        transaction_ok=true
      fi
    fi
    if [[ $transaction_ok == false ]]; then
      # Fall back to the checkupdates lines ("name old -> new"), so the count stays right.
      awk 'NF >= 4 && $3 == "->" { print $1, $4, "unknown", 0 }' "$work/check-out" >"$work/transaction"
      note "The pacman transaction could not be read, so download size and reboot data are unavailable"
    fi
  fi
}

read_transaction
release_lock

wait_background

# Keep only well formed transaction lines: name version repo size.
awk 'NF >= 4 && $4 ~ /^[0-9]+$/' "$work/transaction" >"$work/transaction.clean"
mv "$work/transaction.clean" "$work/transaction"

n_pacman=$(wc -l <"$work/transaction")
n_pacman=$((n_pacman + 0))
n_aur=$(grep -c . "$work/aur")
n_mise=$(grep -c . "$work/mise")

download_mib=null
if (( n_pacman > 0 )) && [[ $transaction_ok == true ]]; then
  total_bytes=$(awk '{ sum += $4 } END { print sum + 0 }' "$work/transaction")
  download_mib=$((total_bytes / 1048576))
fi
download_partial=false
(( n_aur + n_mise > 0 )) && download_partial=true

omarchy_pending=false
omarchy_pkg=""
old_ver=""
new_ver=""
omarchy_pkg=$(awk '$1 == "omarchy" || $1 == "omarchy-dev" { print $1; exit }' "$work/transaction")
if [[ -n $omarchy_pkg ]]; then
  omarchy_pending=true
  new_ver=$(awk -v p="$omarchy_pkg" '$1 == p { print $2; exit }' "$work/transaction")
  if command -v expac >/dev/null 2>&1; then
    old_ver=$(expac -Q '%v' "$omarchy_pkg" 2>/dev/null | head -1)
  else
    note "expac is not installed, the installed Omarchy version is unknown"
  fi
fi

# Reboot rules of `omarchy update`: a kernel, hyprland, or an nvidia driver.
reboot=false
while read -r name _; do
  [[ -n $name ]] || continue
  if pacman -Qlq "$name" 2>/dev/null | grep -q '/vmlinuz$'; then
    reboot=true
  fi
  case $name in
    hyprland | nvidia*) reboot=true ;;
  esac
done <"$work/transaction"

# One section of the report: heading, then the body lines on stdin.
section() { printf '## %s\n' "$1"; cat; printf '\n'; }

ref_of() {
  if [[ $1 =~ \.g([0-9a-f]{7,}) ]]; then
    echo "${BASH_REMATCH[1]}"
  else
    echo "v${1%-*}"
  fi
}

report_pacman() {
  local name new repo size old desc total=0
  while read -r name new repo size; do
    [[ -n $name ]] || continue
    total=$((total + size))
    old=""
    command -v expac >/dev/null 2>&1 && old=$(expac -Q '%v' "$name" 2>/dev/null | head -1)
    desc=""
    command -v expac >/dev/null 2>&1 && desc=$(expac -S '%d' "$name" 2>/dev/null)
    printf '%s %s -> %s [%s] %s MiB | %s\n' "$name" "${old:-NEW}" "$new" "$repo" \
      "$((size / 1048576))" "$desc"
  done <"$work/transaction"
  [[ -s $work/transaction ]] || echo "(none)"
  if [[ $transaction_ok == true ]]; then
    echo "TOTAL download: $((total / 1048576)) MiB"
  else
    echo "TOTAL download: unknown"
  fi
  local n
  for n in "${notes[@]}"; do echo "NOTE: $n"; done
}

report_omarchy() {
  if [[ -z $omarchy_pkg ]]; then
    echo "(omarchy package is up to date)"
    return
  fi
  echo "package: $omarchy_pkg"
  echo "installed: ${old_ver:-unknown}"
  echo "new: $new_ver"
  if [[ -n $old_ver ]]; then
    echo "compare basecamp/omarchy $(ref_of "$old_ver")...$(ref_of "$new_ver")"
  else
    echo "(installed version unknown, no compare line)"
  fi
}

report_local_edits() {
  local names=() name
  while read -r name _; do [[ -n $name ]] && names+=("$name"); done <"$work/transaction"
  if (( ${#names[@]} > 0 )); then
    pacman -Qkk "${names[@]}" 2>&1 |
      grep -E '(checksum|Size) mismatch' | grep -oE '^warning: [^:]+: /[^ ]+' |
      awk '{print $2, $3}' | sort -u >"$work/modified"
  else
    : >"$work/modified"
  fi
  if [[ -s $work/modified ]]; then
    cat "$work/modified"
    echo "pacman hooks that may patch these back (Target -> Exec):"
    local hook target exec_line
    for hook in /etc/pacman.d/hooks/*.hook; do
      [[ -e $hook ]] || continue
      target=$(grep -m1 -E '^Target' "$hook" | sed 's/^Target *= *//')
      exec_line=$(grep -m1 -E '^Exec' "$hook" | sed 's/^Exec *= *//')
      echo "  $(basename "$hook"): $target -> $exec_line"
    done
  else
    echo "(none)"
  fi
}

report_migrations() {
  local out=""
  command -v omarchy-migrate >/dev/null 2>&1 && out=$(omarchy-migrate --pending 2>/dev/null)
  [[ -n $out ]] && printf '%s\n' "$out" || echo "(none)"
}

report_orphans() {
  local out
  out=$(pacman -Qtdq 2>/dev/null)
  [[ -n $out ]] && printf '%s\n' "$out" || echo "(none)"
}

report_file_or_none() {
  [[ -s $1 ]] && cat "$1" || echo "(none)"
}

report_reboot() {
  local name found=false
  while read -r name _; do
    [[ -n $name ]] || continue
    if pacman -Qlq "$name" 2>/dev/null | grep -q '/vmlinuz$'; then
      echo "kernel: $name (omarchy update asks to reboot)"; found=true
    fi
    case $name in
      hyprland) echo "hyprland (omarchy update asks to reboot)"; found=true ;;
      nvidia*) echo "$name (reboot needed, driver and kernel module must match)"; found=true ;;
    esac
  done <"$work/transaction"
  [[ $found == true ]] || echo "(no reboot expected; the shell restarts at the end of every update)"
}

write_report() {
  {
    report_pacman | section "Pacman packages"
    report_omarchy | section "Omarchy"
    report_local_edits | section "Local edits the upgrade overwrites"
    report_migrations | section "Pending migrations"
    report_orphans | section "Orphans"
    report_file_or_none "$work/mise" | section "Mise"
    report_file_or_none "$work/aur" | section "AUR"
    report_reboot | section "Reboot hints"
  } >"$tmp_report"
}

if [[ $mode == --report ]]; then
  if write_report && mv -fT "$tmp_report" "$report_file"; then
    tmp_report=""
    emit_report "$report_file"
  else
    jq -n --arg message "cannot write the report to $report_file" '{state: "error", message: $message}'
  fi
  exit 0
fi

emit ok ""
exit 0
