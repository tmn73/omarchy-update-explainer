#!/usr/bin/env bash
# Print what `omarchy update` would change right now, as one JSON document.
# Read only: it never changes the system. It makes no call to GitHub itself,
# but `mise outdated` may contact the tool sources (GitHub among them), and
# `checkupdates` and `yay -Qua` use the network as `omarchy update` does.
# Every external tool runs under `timeout`, so nothing can hang the widget.
# Contract: one JSON document on stdout, exit 0 for every failure the user can meet.
#
# Usage: omarchy-update-explainer-collect (--summary | --report <file>) [--no-mise]
#
# Test hooks (digits only for the timeouts, anything else is ignored):
# UPDATE_EXPLAINER_NET_TIMEOUT, UPDATE_EXPLAINER_CHECK_TIMEOUT (seconds),
# UPDATE_EXPLAINER_LOCK_WAIT, UPDATE_EXPLAINER_DMI_DIR, UPDATE_EXPLAINER_HOOKS_DIR.
set -uo pipefail

usage() {
  echo "usage: omarchy-update-explainer-collect (--summary | --report <file>) [--no-mise]" >&2
  exit 2
}

mode=${1:-}
report_file=""
skip_mise=false
case $mode in
  --summary) shift ;;
  --report)
    shift
    report_file=${1:-}
    [[ -n $report_file ]] || usage
    shift
    ;;
  *) usage ;;
esac
for arg in "$@"; do
  [[ $arg == --no-mise ]] && skip_mise=true || usage
done

# Seconds from a test hook, or the default when the value is not plain digits.
seconds_or() {
  [[ ${1:-} =~ ^[0-9]+$ ]] && (( 10#$1 > 0 )) && echo "$((10#$1))" || echo "$2"
}
net_timeout=$(seconds_or "${UPDATE_EXPLAINER_NET_TIMEOUT:-}" 60)
check_timeout=$(seconds_or "${UPDATE_EXPLAINER_CHECK_TIMEOUT:-}" 180)

work=$(mktemp -d) || exit 1
tmp_report=""
private_db=""
aur_pid=""
mise_pid=""
fg_pid=""
cleanup() {
  local pid
  for pid in "$aur_pid" "$mise_pid" "$fg_pid"; do
    [[ -n $pid ]] && kill "$pid" 2>/dev/null
  done
  rm -rf "$work"
  [[ -n $tmp_report ]] && rm -f "$tmp_report"
  [[ -n $private_db ]] && rm -rf "$private_db"
  return 0
}
trap cleanup EXIT
trap 'exit 143' TERM INT HUP

notes=()
note() { notes+=("$1"); }

emit() {
  local state=$1 message=$2
  jq -n \
    --arg state "$state" --arg message "$message" \
    --arg generatedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson pending "${omarchy_pending:-false}" \
    --arg package "${omarchy_pkg:-}" --arg from "${old_ver:-}" --arg to "${new_ver:-}" \
    --argjson pacman "${n_pacman:-0}" --argjson aur "${n_aur:-0}" --argjson mise "${n_mise:-0}" \
    --argjson download "${download_mib:-null}" \
    --argjson partial "${download_partial:-false}" \
    --argjson reboot "${reboot:-false}" \
    --argjson ipacman "${items_pacman:-[]}" --argjson iaur "${items_aur:-[]}" \
    --argjson imise "${items_mise:-[]}" \
    --args '{
      state: $state, message: $message, generatedAt: $generatedAt,
      omarchy: {pending: $pending, package: $package, from: $from, to: $to},
      sources: {pacman: $pacman, aur: $aur, mise: $mise},
      total: ($pacman + $aur + $mise),
      downloadMiB: $download, downloadPartial: $partial,
      items: {pacman: $ipacman, aur: $iaur, mise: $imise},
      reboot: $reboot, notes: $ARGS.positional
    }' "${notes[@]}"
}

emit_report() {
  jq -n --arg path "$1" '{state: "ok", path: $path}'
}

# Report an error in the format of the current mode.
fail_out() {
  if [[ $mode == --report ]]; then
    jq -n --arg message "$1" '{state: "error", message: $message}'
  else
    emit error "$1"
  fi
}

if [[ $mode == --report ]]; then
  # Fail early, before the slow collection, when the file cannot be written.
  tmp_report=$(mktemp --suffix=.tmp "$report_file.XXXXXX" 2>&1) || {
    msg=$tmp_report
    tmp_report=""
    jq -n --arg message "cannot write the report: $msg" '{state: "error", message: $message}'
    exit 0
  }
  chmod 600 "$tmp_report"
fi

# Slow network calls run in the background while pacman syncs. The tool runs
# under timeout and is the background process itself, so the cleanup trap can
# kill it. Output is capped and filtered after the wait.
aur_status=0
mise_status=0
: >"$work/aur"
: >"$work/mise"
if command -v yay >/dev/null 2>&1; then
  timeout --kill-after=5 "$net_timeout" yay -Qua >"$work/aur.raw" 2>/dev/null &
  aur_pid=$!
else
  note "yay is not installed, AUR updates were not checked"
fi
if [[ $skip_mise == true ]]; then
  :
elif command -v mise >/dev/null 2>&1; then
  MISE_MINIMUM_RELEASE_AGE=0 timeout --kill-after=5 "$net_timeout" mise outdated --no-header \
    >"$work/mise.raw" 2>/dev/null &
  mise_pid=$!
else
  note "mise is not installed, tool updates were not checked"
fi
timed_out() { (( $1 == 124 || $1 == 137 )); }
wait_background() {
  if [[ -n $aur_pid ]]; then
    wait "$aur_pid"
    aur_status=$?
    aur_pid=""
    head -c 65536 "$work/aur.raw" | grep -vE '^(gcc14|gcc14-libs) ' >"$work/aur"
    timed_out "$aur_status" && note "The AUR check timed out, so AUR updates may be missing"
  fi
  if [[ -n $mise_pid ]]; then
    wait "$mise_pid"
    mise_status=$?
    mise_pid=""
    # A tool that is declared but not installed shows "[MISSING]" as its current
    # version. It has nothing to update, so this one filter drops it for both
    # the summary count and the report.
    head -c 65536 "$work/mise.raw" | grep -vF '[MISSING]' >"$work/mise"
    timed_out "$mise_status" && note "The mise check timed out, so tool updates may be missing"
  fi
  return 0
}

# Run a tool in the background and wait for it, under timeout. The wait can be
# interrupted by the trap, and the child never holds the lock descriptor.
run_fg() {
  timeout --kill-after=5 "$1" "${@:2}" 9>&- &
  fg_pid=$!
  wait "$fg_pid"
  local rc=$?
  fg_pid=""
  return "$rc"
}

if ! command -v checkupdates >/dev/null 2>&1; then
  wait_background
  fail_out "checkupdates is not installed (package pacman-contrib)"
  exit 0
fi

# checkupdates and `pacman -Sup` share one sync database and one lock file.
# Two overlapping runs (ours, or the stock update widget) make the second one
# fail. So this helper syncs a private database. With a runtime directory, the
# database lives there and a lock serializes our own runs (descriptor 9, opened
# after the background jobs start and closed for every child). Without one, the
# database is a private temporary directory removed at exit. The stock shared
# path is never used.
runtime_dir=${XDG_RUNTIME_DIR:-}
state_dir="$runtime_dir/update-explainer"
if [[ -n $runtime_dir ]] && mkdir -p -m 700 "$state_dir" 2>/dev/null; then
  export CHECKUPDATES_DB="$state_dir/checkup-db/"
  if command -v flock >/dev/null 2>&1 && exec 9>"$state_dir/collect.lock" 2>/dev/null; then
    if ! flock -w "$(seconds_or "${UPDATE_EXPLAINER_LOCK_WAIT:-}" 120)" 9; then
      wait_background
      fail_out "another update check is still running, try again in a moment"
      exit 0
    fi
  fi
else
  private_db=$(mktemp -d 2>/dev/null) || {
    wait_background
    fail_out "cannot create a private folder for the update database"
    exit 0
  }
  export CHECKUPDATES_DB="$private_db/db/"
fi
release_lock() { exec 9>&-; }

run_fg "$net_timeout" checkupdates --nocolor >"$work/check-out" 2>"$work/check-err"
check_status=$?
if timed_out "$check_status"; then
  release_lock
  wait_background
  fail_out "checkupdates timed out, check your network and try again"
  exit 0
fi
if (( check_status == 1 )); then
  release_lock
  wait_background
  err=$(head -c 2000 "$work/check-err")
  fail_out "checkupdates failed: ${err:-no error text}"
  exit 0
fi

# Read the pacman transaction into $work/transaction ("name version repo size").
# Sets transaction_ok. Used by both modes. Falls back to the checkupdates lines.
read_transaction() {
  : >"$work/transaction"
  transaction_ok=true
  if (( check_status == 0 )); then
    transaction_ok=false
    if command -v fakeroot >/dev/null 2>&1; then
      if run_fg "$net_timeout" fakeroot -- pacman -Sup --disable-sandbox-filesystem \
        --dbpath "$CHECKUPDATES_DB" --logfile /dev/null \
        --print-format '%n %v %r %s' >"$work/transaction" 2>/dev/null; then
        transaction_ok=true
      fi
    fi
    if [[ $transaction_ok == false ]]; then
      # Fall back to the checkupdates lines ("name old -> new"), so the count stays right.
      awk 'NF >= 4 && $3 == "->" { print $1, $4, "unknown", 0 }' "$work/check-out" >"$work/transaction"
      note "The pacman transaction could not be read, so download size and reboot data are unavailable"
    fi
  fi
}

read_transaction
release_lock

wait_background

# Keep only well formed transaction lines: name version repo size.
awk 'NF >= 4 && $4 ~ /^[0-9]+$/' "$work/transaction" >"$work/transaction.clean"
mv "$work/transaction.clean" "$work/transaction"

n_pacman=$(wc -l <"$work/transaction")
n_pacman=$((n_pacman + 0))
n_aur=$(grep -c . "$work/aur")
n_mise=$(grep -c . "$work/mise")

download_mib=null
if (( n_pacman > 0 )) && [[ $transaction_ok == true ]]; then
  total_bytes=$(awk '{ sum += $4 } END { print sum + 0 }' "$work/transaction")
  download_mib=$((total_bytes / 1048576))
fi
download_partial=false
(( n_aur + n_mise > 0 )) && download_partial=true

# The first five items of each source, for the panel. Each list is built by jq
# from tab separated lines on stdin, never by string building, and the finished
# JSON arrays reach the final jq as --argjson values.
declare -A check_old=()
while read -r cname cold carrow _; do
  [[ $carrow == "->" ]] && check_old[$cname]=$cold
done <"$work/check-out"

pacman_items() {
  local name new old _repo _size
  while read -r name new _repo _size; do
    [[ -n $name ]] || continue
    old=${check_old[$name]:-}
    if [[ -z $old ]] && command -v expac >/dev/null 2>&1; then
      old=$(expac -Q '%v' "$name" 2>/dev/null | head -1)
    fi
    printf '%s\t%s\t%s\n' "$name" "$old" "$new"
  done < <(head -5 "$work/transaction")
}

to_items() {
  jq -R -s -c 'split("\n") | map(select(length > 0) | split("\t"))
    | map({name: .[0], from: (.[1] // ""), to: (.[2] // "")})'
}

items_pacman=$(pacman_items | to_items)
items_aur=$(awk 'NF >= 4 && $3 == "->" { printf "%s\t%s\t%s\n", $1, $2, $4 }' "$work/aur" | head -5 | to_items)
items_mise=$(awk 'NF >= 4 { printf "%s\t%s\t%s\n", $1, $3, $4 }' "$work/mise" | head -5 | to_items)

omarchy_pending=false
omarchy_pkg=""
old_ver=""
new_ver=""
omarchy_pkg=$(awk '$1 == "omarchy" || $1 == "omarchy-dev" { print $1; exit }' "$work/transaction")
if [[ -n $omarchy_pkg ]]; then
  omarchy_pending=true
  new_ver=$(awk -v p="$omarchy_pkg" '$1 == p { print $2; exit }' "$work/transaction")
  if command -v expac >/dev/null 2>&1; then
    old_ver=$(expac -Q '%v' "$omarchy_pkg" 2>/dev/null | head -1)
  else
    note "expac is not installed, the installed Omarchy version is unknown"
  fi
fi

# Reboot rules of `omarchy update`: a kernel, hyprland, or an nvidia driver.
# Only a package whose name can ship a kernel gets the (slow) file list check.
kernel_candidate() { [[ $1 == linux* || $1 == *kernel* ]]; }
reboot=false
kernel_pkgs=()
while read -r name _; do
  [[ -n $name ]] || continue
  # The list is read in full before grep looks at it. `grep -q` in a pipe
  # exits at the first match, and pacman then dies of SIGPIPE, which pipefail
  # reports as "no kernel here".
  if kernel_candidate "$name" &&
    files=$(timeout --kill-after=5 "$check_timeout" pacman -Qlq "$name" 2>/dev/null) &&
    grep -q '/vmlinuz$' <<<"$files"; then
    reboot=true
    kernel_pkgs+=("$name")
  fi
  case $name in
    hyprland | nvidia*) reboot=true ;;
  esac
done <"$work/transaction"

# One section of the report: heading, then the body lines on stdin.
section() { printf '## %s\n' "$1"; cat; printf '\n'; }

ref_of() {
  if [[ $1 =~ \.g([0-9a-f]{7,}) ]]; then
    echo "${BASH_REMATCH[1]}"
  else
    echo "v${1%-*}"
  fi
}

# Hardware and system facts that let the agent judge whether a change matters
# on this machine. Read only. It reads model names and versions only: never a
# serial number, UUID, MAC address or hostname.
report_machine() {
  local dmi=${UPDATE_EXPLAINER_DMI_DIR:-/sys/class/dmi/id} value line
  value=$(head -n1 "$dmi/product_name" 2>/dev/null)
  echo "model: ${value:-unknown}"
  value=$(head -n1 "$dmi/sys_vendor" 2>/dev/null)
  echo "vendor: ${value:-unknown}"
  value=""
  command -v lscpu >/dev/null 2>&1 &&
    value=$(lscpu 2>/dev/null | awk -F: '/^Model name/ { sub(/^[ \t]+/, "", $2); print $2; exit }')
  echo "cpu: ${value:-unknown}"
  local gpus=""
  command -v lspci >/dev/null 2>&1 &&
    gpus=$(lspci 2>/dev/null | grep -E '^[^[:space:]]+ (VGA compatible controller|3D controller|Display controller):' |
      sed -E 's/^[^ ]+ //; s/ \[[0-9a-f]{4}:[0-9a-f]{4}\]//; s/ \(rev [0-9a-f]+\)$//')
  if [[ -n $gpus ]]; then
    while IFS= read -r line; do echo "gpu: $line"; done <<<"$gpus"
  else
    echo "gpu: unknown"
  fi
  value=$(uname -r 2>/dev/null)
  echo "kernel: ${value:-unknown}"
  value=$(pacman -Q omarchy 2>/dev/null || pacman -Q omarchy-dev 2>/dev/null)
  echo "omarchy: ${value:-unknown}"
  echo "session: ${XDG_SESSION_TYPE:-unknown}"
}

report_pacman() {
  local name new repo size old desc total=0 line n v
  local names=()
  declare -A oldv=() descv=()
  while read -r name _; do [[ -n $name ]] && names+=("$name"); done <"$work/transaction"
  if (( ${#names[@]} > 0 )) && command -v expac >/dev/null 2>&1; then
    while IFS=$'\t' read -r n v; do oldv[$n]=$v; done < <(expac -Q '%n\t%v' "${names[@]}" 2>/dev/null)
    while IFS=$'\t' read -r n v; do descv[$n]=$v; done < <(expac -S '%n\t%d' "${names[@]}" 2>/dev/null)
  fi
  while read -r name new repo size; do
    [[ -n $name ]] || continue
    total=$((total + size))
    old=${oldv[$name]:-}
    desc=${descv[$name]:-}
    printf '%s %s -> %s [%s] %s MiB | %s\n' "$name" "${old:-NEW}" "$new" "$repo" \
      "$((size / 1048576))" "$desc"
  done <"$work/transaction"
  [[ -s $work/transaction ]] || echo "(none)"
  if [[ $transaction_ok == true ]]; then
    if (( total > 0 && total < 1048576 )); then
      echo "TOTAL download: under 1 MiB"
    else
      echo "TOTAL download: $((total / 1048576)) MiB"
    fi
  else
    echo "TOTAL download: unknown"
  fi
  local n
  for n in "${notes[@]}"; do echo "NOTE: $n"; done
}

report_omarchy() {
  if [[ -z $omarchy_pkg ]]; then
    echo "(omarchy package is up to date)"
    return
  fi
  echo "package: $omarchy_pkg"
  echo "installed: ${old_ver:-unknown}"
  echo "new: $new_ver"
  if [[ -n $old_ver ]]; then
    echo "compare basecamp/omarchy $(ref_of "$old_ver")...$(ref_of "$new_ver")"
  else
    echo "(installed version unknown, no compare line)"
  fi
}

# The slow file check runs in the main shell (not in a pipeline) so the cleanup
# trap can stop it.
collect_local_edits() {
  local names=() name
  : >"$work/modified"
  qkk_status=0
  while read -r name _; do [[ -n $name ]] && names+=("$name"); done <"$work/transaction"
  (( ${#names[@]} > 0 )) || return 0
  run_fg "$check_timeout" pacman -Qkk "${names[@]}" >"$work/qkk" 2>&1
  qkk_status=$?
  timed_out "$qkk_status" && return 0
  head -c 1048576 "$work/qkk" |
    grep -E '(checksum|Size) mismatch' | grep -oE '^warning: [^:]+: /[^ ]+' |
    awk '{print $2, $3}' | sort -u >"$work/modified"
}

report_local_edits() {
  if timed_out "$qkk_status"; then
    echo "(file check timed out)"
  elif [[ -s $work/modified ]]; then
    cat "$work/modified"
    echo "pacman hooks that may patch these back (file name and Target):"
    local hook target hooks_dir=${UPDATE_EXPLAINER_HOOKS_DIR:-/etc/pacman.d/hooks}
    for hook in "$hooks_dir"/*.hook; do
      [[ -e $hook ]] || continue
      target=$(grep -m1 -E '^Target' "$hook" | sed 's/^Target *= *//')
      echo "  $(basename "$hook"): $target"
    done
  else
    echo "(none)"
  fi
}

report_migrations() {
  local out=""
  command -v omarchy-migrate >/dev/null 2>&1 && out=$(omarchy-migrate --pending 2>/dev/null)
  [[ -n $out ]] && printf '%s\n' "$out" || echo "(none)"
}

report_orphans() {
  local out
  out=$(pacman -Qtdq 2>/dev/null)
  [[ -n $out ]] && printf '%s\n' "$out" || echo "(none)"
}

report_file_or_none() {
  [[ -s $1 ]] && cat "$1" || echo "(none)"
}

report_reboot() {
  local name found=false
  for name in "${kernel_pkgs[@]}"; do
    echo "kernel: $name (omarchy update asks to reboot)"; found=true
  done
  while read -r name _; do
    [[ -n $name ]] || continue
    case $name in
      hyprland) echo "hyprland (omarchy update asks to reboot)"; found=true ;;
      nvidia*) echo "$name (reboot needed, driver and kernel module must match)"; found=true ;;
    esac
  done <"$work/transaction"
  [[ $found == true ]] || echo "(no reboot expected; the shell restarts at the end of every update)"
}

report_cap=262144

write_report() {
  collect_local_edits
  # Tool, current and latest only: the config path adds nothing and can hold a user name.
  awk 'NF >= 4 { print $1, $3, $4 }' "$work/mise" >"$work/mise.report"
  # One AUR line is at most 120 characters: the maintainer controls its text.
  cut -c1-120 "$work/aur" >"$work/aur.report"
  {
    report_machine | section "This machine"
    report_pacman | section "Pacman packages"
    report_omarchy | section "Omarchy"
    report_local_edits | section "Local edits the upgrade overwrites"
    report_migrations | section "Pending migrations"
    report_orphans | section "Orphans"
    report_file_or_none "$work/mise.report" | section "Mise"
    report_file_or_none "$work/aur.report" | section "AUR"
    report_reboot | section "Reboot hints"
  } >"$tmp_report"
  if (( $(stat -c %s "$tmp_report") > report_cap )); then
    head -c "$report_cap" "$tmp_report" | iconv -c -f utf-8 -t utf-8 >"$work/cut"
    printf '\n[truncated: the report was cut at 256 KiB]\n' >>"$work/cut"
    cat "$work/cut" >"$tmp_report"
  fi
}

if [[ $mode == --report ]]; then
  if write_report && mv -fT "$tmp_report" "$report_file"; then
    tmp_report=""
    emit_report "$report_file"
  else
    jq -n --arg message "cannot write the report to $report_file" '{state: "error", message: $message}'
  fi
  exit 0
fi

emit ok ""
exit 0
